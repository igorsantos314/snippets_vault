# URL de conexão com o banco de dados SQLite
DATABASE_URL="file:./dev.db"

# Chave secreta para assinar os tokens JWT (mínimo 32 caracteres)
JWT_SECRET="troque_por_uma_chave_secreta_forte_de_pelo_menos_32_chars"

# Tempo de expiração do JWT (ex: 7d, 1h, 30m)
JWT_EXPIRES_IN="7d"

# Porta em que a API irá rodar
PORT=3000

# Host (use 0.0.0.0 para aceitar conexões externas)
HOST=0.0.0.0

# Ambiente de execução (development | production | test)
NODE_ENV=development
